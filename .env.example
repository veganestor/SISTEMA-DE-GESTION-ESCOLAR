# Puerto del servidor unificado Express + Vite
PORT=3000

# Ruta persistente de la base de datos SQLite de asistencia (no usar rutas temporales ni :memory:)
ATTENDANCE_DB_PATH=data/attendance.db

# Secreto criptográfico HMAC (>= 32 caracteres aleatorios, ej: openssl rand -hex 32)
# Configurar en los secretos del entorno de despliegue para mantener sesiones entre reinicios.
SESSION_SECRET=

# Código administrativo del servidor (>= 8 caracteres seguros) para alta inicial y recuperación de acceso admin.
# Configurar exclusivamente en variables/secretos del entorno del servidor (nunca exponer en frontend).
ATTENDANCE_ADMIN_PASSCODE=
